# ---------------------------------------------------------------------------
# Verilex backend — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Supabase Postgres) -------------------------------------------
# No local PostgreSQL install is required. Create a project at
# https://supabase.com, then Project Settings -> Database -> Connection
# string ("URI" tab). Two options:
#   - Direct connection (simplest, fine for this app):
#       postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   - Session pooler (use if your network blocks direct outbound to :5432,
#     e.g. some serverless/CI hosts):
#       postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Enable the "vector" extension once for the project — either toggle it on
# under Database -> Extensions in the Supabase dashboard, or just run
# `npm run migrate` (schema.sql creates it with CREATE EXTENSION IF NOT
# EXISTS, which the Supabase postgres role is permitted to do).
DATABASE_URL=
# TLS is required by Supabase and is enabled automatically for any
# non-localhost host ("auto"). Override with "true" / "false" if needed.
DATABASE_SSL=auto

# --- Legal source provider -------------------------------------------------
# Which provider to use for retrieval. "mock" is a clearly-separated local
# provider for development when no real API credentials are configured.
# Never mix mock results with a production deployment.
LEGAL_PROVIDER=mock

# Indian Kanoon API (https://api.indiankanoon.org/) — real provider
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# --- LLM provider (explanation layer) --------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embedding provider (semantic index) ------------------------------------
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Sessions ----------------------------------------------------------------
# Long, random secret used to sign the session cookie. Generate with e.g.
# `openssl rand -base64 48`. Required for authentication to work.
SESSION_SECRET=
# Set to "true" behind HTTPS in production so the cookie requires Secure.
SESSION_COOKIE_SECURE=false
# "lax" for same-site dev/deployments; "none" (with SESSION_COOKIE_SECURE=true)
# only if the frontend and backend are on genuinely different origins.
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_MS=2592000000

# --- Google OAuth --------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
